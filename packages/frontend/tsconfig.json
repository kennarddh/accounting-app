{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"rootDir": "../..",
		"isolatedModules": true,
		"removeComments": true,
		"sourceMap": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "DOM.Iterable", "ES2023", "WebWorker"],
		"plugins": [
			{
				"name": "@styled/typescript-styled-plugin",
				"lint": {
					"duplicateProperties": "error",
					"zeroUnits": "warning",
					"ieHack": "error",
					"important": "warning"
				}
			}
		],
		"paths": {
			"Components/*": ["./src/Components/*"],
			"Contexts/*": ["./src/Contexts/*"],
			"Utils/*": ["./src/Utils/*"],
			"Hooks/*": ["./src/Hooks/*"],
			"Constants/*": ["./src/Constants/*"],
			"Api/*": ["./src/Api/*"],
			"Pages/*": ["./src/Pages/*"],
			"Outlets/*": ["./src/Outlets/*"],
			"Stores/*": ["./src/Stores/*"],
			"@accounting-app/common": ["../common"],
			"@mui/styled-engine": ["./node_modules/@mui/styled-engine-sc"]
		},
		"types": ["vite/client", "vite-plugin-pwa/react"]
	},
	"include": ["src", "vite.config.ts", "../common/src"]
}
