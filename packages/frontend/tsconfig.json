{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"rootDir": "../..",
		"isolatedModules": true,
		"removeComments": true,
		"sourceMap": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "DOM.Iterable", "ES2023", "WebWorker"],
		"paths": {
			"Components/*": ["./src/Components/*"],
			"Contexts/*": ["./src/Contexts/*"],
			"Utils/*": ["./src/Utils/*"],
			"Hooks/*": ["./src/Hooks/*"],
			"Constants/*": ["./src/Constants/*"],
			"Api/*": ["./src/Api/*"],
			"Pages/*": ["./src/Pages/*"],
			"Outlets/*": ["./src/Outlets/*"],
			"Stores/*": ["./src/Stores/*"],
			"@accounting-app/common": ["../common"],
		},
		"types": ["vite/client", "vite-plugin-pwa/react"]
	},
	"include": ["src", "vite.config.ts", "../common/src"]
}
